# ─────────────────────────────────────────────────────────────
# CCD.SCHOOL — Environment Variables
# Copy this file to .env.local and fill in your values.
# ─────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────

# NextAuth secret — generate with: openssl rand -base64 32
AUTH_SECRET=your-minimum-32-char-random-secret-here

# Full URL of your deployment (no trailing slash)
NEXTAUTH_URL=http://localhost:3000

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql://user:password@localhost:5432/ccdschool

# Stripe (get from dashboard.stripe.com)
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# AI Beat Coach (get from platform.moonshot.cn) — REQUIRED for Beat Coach feature
# Without this key the Beat Coach button still appears but returns a static fallback.
# Get your key at: https://platform.moonshot.cn → API Keys → Create new key
# This is the #1 most impactful feature to enable before any marketing.
KIMI_API_KEY=sk-...

# ── OPTIONAL ─────────────────────────────────────────────────

# Where this app lives, and where the rest of Cats Can Dance lives.
# Defaults shown. Set NEXT_PUBLIC_SITE_URL to https://learn.catscandance.com
# once that domain points at this project.
NEXT_PUBLIC_SITE_URL=https://ccd.school
NEXT_PUBLIC_CCD_URL=https://catscandance.com

# Google OAuth (get from console.cloud.google.com → APIs & Credentials)
# Required for "Continue with Google" on the login page.
# Without these, Google sign-in is hidden and only email/password works.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Analytics — PostHog (app.posthog.com)
# If not set, all analytics calls are silent no-ops.
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Web Push notifications (generate with: npx web-push generate-vapid-keys)
# If not set, push notification features are disabled.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:hello@ccd.school

# Cron authentication (for /api/push/send-streak-reminder)
CRON_SECRET=random-secret-string

# Admin gating (for /admin routes)
ADMIN_PASSWORD=choose-a-password-for-the-admin-page

# Razorpay (India, INR). Optional: the India option stays hidden until these are set.
# Dashboard: Subscriptions > Plans. Create a monthly and an annual plan, paste the plan_ ids.
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_PLAN_MONTHLY=plan_...
RAZORPAY_PLAN_ANNUAL=plan_...
RAZORPAY_WEBHOOK_SECRET=...
# Webhook URL: https://<your-domain>/api/razorpay/webhook
# Events: subscription.activated, charged, cancelled, completed, halted, resumed
NEXT_PUBLIC_INR_PRICE_MONTHLY=
NEXT_PUBLIC_INR_PRICE_ANNUAL=
