# ─────────────────────────────────────────────────────────────
# CCD.SCHOOL — Environment Variables
# Rename this file to .env.local and fill in every value below.
# NEVER commit this file to git.
# ─────────────────────────────────────────────────────────────


# ══════════════════════════════════════════════════════════════
# 🔴 REQUIRED — Sign-in will not work without these
# ══════════════════════════════════════════════════════════════

# NextAuth secret — generate one at: https://generate-secret.vercel.app/32
# Or run in terminal: openssl rand -base64 32
AUTH_SECRET=

# Full URL of your deployment (no trailing slash)
# Local dev:  http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL=

# PostgreSQL connection string — required for email AND Google sign-in
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Providers: Supabase, Neon, Railway, PlanetScale, Render, etc.
DATABASE_URL=


# ══════════════════════════════════════════════════════════════
# 🔴 REQUIRED FOR GOOGLE SIGN-IN
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI to add: <NEXTAUTH_URL>/api/auth/callback/google
# ══════════════════════════════════════════════════════════════

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=


# ══════════════════════════════════════════════════════════════
# 🟡 REQUIRED FOR PAYMENTS (Stripe)
# Get from: https://dashboard.stripe.com → Developers → API Keys
# ══════════════════════════════════════════════════════════════

STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=


# ══════════════════════════════════════════════════════════════
# 🟡 REQUIRED FOR AI BEAT COACH
# Get from: https://platform.moonshot.cn → API Keys → Create new key
# ══════════════════════════════════════════════════════════════

KIMI_API_KEY=


# ══════════════════════════════════════════════════════════════
# ⚪ OPTIONAL — App works without these
# ══════════════════════════════════════════════════════════════

# Analytics (PostHog) — https://app.posthog.com
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Web Push notifications
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Cron job secret (for streak reminder push notifications)
CRON_SECRET=

# Admin route gating (/admin pages)
ADMIN_SECRET=
