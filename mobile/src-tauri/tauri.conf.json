{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ccd school",
  "version": "0.1.0",
  "identifier": "com.catscandance.school",
  "build": {
    "frontendDist": "../www",
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devUrl": "http://localhost:3000/lab/engine"
  },
  "app": {
    "windows": [
      {
        "title": "ccd school",
        "width": 430,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
